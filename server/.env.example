# Copy this file to `server/.env` and fill in real values.
# Never commit the resulting .env. It is gitignored.

# REQUIRED. Signing key for JSON Web Tokens. Must be at least 32 characters.
# The server refuses to start if this is missing or too short.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/Pelegram

# Origin allowed to call the API (the Angular dev server by default).
# Must be a concrete origin. "*" is rejected, because the API allows credentials.
CORS_ORIGIN=http://localhost:4200

# Number of reverse proxies between clients and this server.
# Leave at 0 when the server is reachable directly. Raising it makes the server
# read the client address from X-Forwarded-For, which a client can forge and
# rotate to bypass the login rate limit if nothing actually rewrites that header.
# Set it to the real hop count (usually 1) only when behind a proxy you control.
TRUST_PROXY=0

# Public base URL of this server, used to build absolute media URLs.
BASE_URL=http://localhost:3000

# Port the HTTP server listens on.
PORT=3000

# development | production | test
NODE_ENV=development

# error | warn | info | debug
# Defaults to "info" in development and "warn" in production.
LOG_LEVEL=info

# Cloudinary credentials. REQUIRED only when NODE_ENV=production,
# where uploads are stored on Cloudinary instead of the local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
